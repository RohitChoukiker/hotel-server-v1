APP__ENVIRONMENT=production
APP__DEBUG=false
APP__PUBLIC_BASE_URL=https://api.example.com
APP__TRUSTED_HOSTS=["api.example.com"]

DATABASE__URL=postgresql+asyncpg://hotel_app:URL_ENCODED_PASSWORD@PRIVATE_SQL_IP:5432/hotel
DATABASE__POOL_SIZE=20
DATABASE__MAX_OVERFLOW=20

REDIS__URL=redis://:REDIS_PASSWORD@redis:6379/0
REDIS__CACHE_PREFIX=hotel-platform
REDIS__FAIL_OPEN=false

JWT__SECRET_KEY=REPLACE_FROM_SECRET_MANAGER_WITH_48_RANDOM_CHARACTERS
JWT__ALGORITHM=HS256
JWT__ACCESS_TOKEN_MINUTES=15
JWT__REFRESH_TOKEN_DAYS=30

CORS__ALLOWED_ORIGINS=["https://app.example.com"]
CORS__ALLOW_CREDENTIALS=true

LOGGING__LEVEL=INFO
LOGGING__JSON_LOGS=true
SENTRY__DSN=
SENTRY__TRACES_SAMPLE_RATE=0.1

LLM__PROVIDER=deterministic
LLM__API_KEY=
LLM__MODEL=gpt-5-mini

STORAGE__BACKEND=gcs
STORAGE__GCS_BUCKET=PROJECT_ID-hotel-imports
GCP__PROJECT_ID=PROJECT_ID

WORKER__TASK_TIME_LIMIT_SECONDS=3600
WORKER__IMPORT_BATCH_SIZE=1000
WORKER__SCRAPER_CONCURRENCY=4

SCRAPER__TRIPADVISOR_ENABLED=false
SCRAPER__TRIPADVISOR_COOKIE=
