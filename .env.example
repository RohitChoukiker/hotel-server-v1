APP__ENVIRONMENT=development
APP__APP_NAME=Hotel Recommendation API
APP__API_PREFIX=/api/v1
APP__DEBUG=false
APP__PUBLIC_BASE_URL=http://localhost:8000
APP__TRUSTED_HOSTS=["localhost","127.0.0.1"]
APP__MAX_REQUEST_BYTES=2147483648

DATABASE__URL=postgresql+asyncpg://hotel:change-me@postgres:5432/hotel
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=20
DATABASE__POOL_TIMEOUT_SECONDS=30

REDIS__URL=redis://redis:6379/0
REDIS__CACHE_PREFIX=hotel-platform
REDIS__FAIL_OPEN=true

JWT__SECRET_KEY=replace-with-at-least-32-random-characters
JWT__ALGORITHM=HS256
JWT__ACCESS_TOKEN_MINUTES=15
JWT__REFRESH_TOKEN_DAYS=30
JWT__ISSUER=hotel-platform
JWT__AUDIENCE=hotel-platform-users

CORS__ALLOWED_ORIGINS=["http://localhost:3000"]
CORS__ALLOW_CREDENTIALS=true

LOGGING__LEVEL=INFO
LOGGING__JSON_LOGS=true
SENTRY__DSN=
SENTRY__TRACES_SAMPLE_RATE=0.1

LLM__PROVIDER=deterministic
LLM__BASE_URL=https://api.openai.com/v1
LLM__API_KEY=
LLM__MODEL=gpt-5-mini
LLM__TIMEOUT_SECONDS=30

STORAGE__BACKEND=local
STORAGE__LOCAL_PATH=/data/imports
STORAGE__GCS_BUCKET=

GCP__PROJECT_ID=
GCP__SECRET_PREFIX=hotel-platform

WORKER__TASK_TIME_LIMIT_SECONDS=3600
WORKER__IMPORT_BATCH_SIZE=1000
WORKER__SCRAPER_CONCURRENCY=4

RATE_LIMITS__AUTH=10/minute
RATE_LIMITS__SEARCH=120/minute
RATE_LIMITS__CHAT=30/minute
RATE_LIMITS__RECOMMENDATION=20/minute
RATE_LIMITS__ADMIN_IMPORT=5/hour

SCRAPER__TRIPADVISOR_ENABLED=false
SCRAPER__REQUEST_TIMEOUT_SECONDS=30
SCRAPER__MAX_RETRIES=5
SCRAPER__USER_AGENT=HotelPlatformDataOperator/1.0
SCRAPER__TRIPADVISOR_COOKIE=
